# Sentinel settings — keys are the platform's names; values copied from
# the old project's variables as noted. KEY=VALUE only, # starts a comment.

# From old AZURE_OPENAI_ENDPOINT — a URL, e.g. https://<resource>.openai.azure.com/
MODEL_SERVICE_ENDPOINT=PASTE_OLD_AZURE_OPENAI_ENDPOINT_VALUE

# From old AZURE_OPENAI_DEPLOYMENT — a deployment NAME that exists in that
# Azure resource (NOT gpt-6-sol — that's the coding agent, unrelated)
MODEL_CHAT_DEPLOYMENT=PASTE_OLD_AZURE_OPENAI_DEPLOYMENT_VALUE

# From old OPENAI_API_VERSION — a date-like string, e.g. 2024-06-01
MODEL_API_VERSION=PASTE_OLD_OPENAI_API_VERSION_VALUE

# From old AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT — a deployment NAME
# (text-embedding-3-small is fine IF a deployment by that name exists there)
MODEL_EMBEDDINGS_DEPLOYMENT=PASTE_OLD_AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT_VALUE

# From old AZURE_DOCINTEL_ENDPOINT — a URL
DOCINTEL_ENDPOINT=PASTE_OLD_AZURE_DOCINTEL_ENDPOINT_VALUE

# The document store — persistent mount, as you already set it
DOC_STORE_DIR=/mnt/private/platform
